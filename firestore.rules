rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // Lee el doc del usuario autenticado para obtener su rol
    // Coste: 1 lectura extra por verificación de rol (aceptable para este volumen)
    function myRole() {
      return get(/databases/$(database)/documents/usuarios/$(myEmail())).data.rol;
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    function isAdminLike() {
      // admin, director y proyecto tienen acceso total de lectura/escritura
      return myRole() in ['admin', 'director', 'proyecto'];
    }

    function canReadAll() {
      // oficina también puede leer todo pero no escribir
      return myRole() in ['admin', 'director', 'proyecto', 'oficina'];
    }

    // Editores de la web pública (arp-web-preview) — no depende de rol,
    // son personas concretas autorizadas independientemente de su rol en la app interna
    function isConfigEditor() {
      // config/empresa y config/tarifas de la web pública: Guillermo y José Manuel
      return isAuth() && myEmail() in [
        'guimarcon.arp@gmail.com',
        'josmorvel.arp@gmail.com'
      ];
    }

    function isBlogEditor() {
      // posts de la web pública: Guillermo, José Manuel y Natalia
      return isAuth() && myEmail() in [
        'guimarcon.arp@gmail.com',
        'josmorvel.arp@gmail.com',
        'natcrualb.arp@gmail.com'
      ];
    }

    // ── usuarios ───────────────────────────────────────────────────────────
    // Cualquier autenticado lee (necesario para cargarInspectores en nueva-inspeccion.html)
    // Solo admin escribe
    match /usuarios/{email} {
      allow read:  if isAuth();
      allow write: if isAuth() && isAdmin();
    }

    // ── inspecciones ───────────────────────────────────────────────────────
    match /inspecciones/{docId} {
      allow read: if isAuth() && (
        canReadAll() ||
        resource.data.inspectorEmail  == myEmail() ||
        resource.data.inspector2Email == myEmail()
      );

      // Inspector y admin/director/proyecto pueden crear
      // oficina no puede crear inspecciones
      allow create: if isAuth() && myRole() != 'oficina';

      // Inspector solo actualiza las suyas; admin/director/proyecto actualizan cualquiera
      allow update: if isAuth() && (
        isAdminLike() ||
        resource.data.inspectorEmail  == myEmail() ||
        resource.data.inspector2Email == myEmail()
      );

      // Solo admin borra
      allow delete: if isAuth() && isAdmin();
    }

    // ── config ─────────────────────────────────────────────────────────────
    // resultado.html y inspeccion.html la leen en runtime (todos los roles)
    // Solo admin modifica config de empresa/formato
    match /config/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth() && isAdmin();
    }

    // config/empresa y config/tarifas también los lee la web pública
    // (arp-web-preview, sin login) — se suma a la regla genérica de arriba
    match /config/empresa {
      allow read:  if true;
      allow write: if isConfigEditor();
    }
    match /config/tarifas {
      allow read:  if true;
      allow write: if isConfigEditor();
    }

    // historial de formatos (subcollección de config/{alcance})
    match /config/{alcance}/historial/{rev} {
      allow read:  if isAuth();
      allow write: if isAuth() && isAdminLike();
    }

    // ── instalaciones ──────────────────────────────────────────────────────
    // Todos leen (inspectores necesitan buscar instalaciones en nueva-inspeccion)
    // Inspectores crean instalaciones nuevas y actualizan ultimaInspeccion al completar
    // Solo admin/director/proyecto eliminan
    match /instalaciones/{docId} {
      allow read:            if isAuth();
      allow create, update:  if isAuth() && myRole() != 'oficina';
      allow delete:          if isAuth() && isAdminLike();
    }

    // ── clientes ───────────────────────────────────────────────────────────
    match /clientes/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth() && isAdminLike();
    }

    // ── contactos ──────────────────────────────────────────────────────────
    match /contactos/{docId} {
      allow read:  if isAuth() && canReadAll();
      allow write: if isAuth() && isAdminLike();
    }

    // ── equipos ────────────────────────────────────────────────────────────
    // Todos leen (inspectores ven sus equipos asignados)
    // Solo admin/director/proyecto modifican fichas de calibración
    match /equipos/{docId} {
      allow read:  if isAuth();
      allow write: if isAuth() && isAdminLike();
    }

    // historial de calibraciones/verificaciones (subcolección de equipos/{id})
    match /equipos/{docId}/calibraciones/{calId} {
      allow read:  if isAuth();
      allow write: if isAuth() && isAdminLike();
    }

    // ── tiposEquipo ────────────────────────────────────────────────────────
    // Plantillas de tipo de equipo (magnitud, tipoConfirmacion, series, tolerancias)
    // Todos leen (necesario para renderizar la ficha en admin-equipos.html)
    // Solo admin/director/proyecto editan
    match /tiposEquipo/{tipoId} {
      allow read:  if isAuth();
      allow write: if isAuth() && isAdminLike();
    }

    // ── certificados-publicos ──────────────────────────────────────────────
    // Lectura pública — solo nombre, lugar (municipio/provincia), lat/lng,
    // fechaValidez y tipo. Sin datos de clientes, inspectores ni NCs.
    match /certificados-publicos/{docId} {
      allow read:  if true;
      allow write: if isAuth() && myRole() != 'oficina';
    }

    // ── posts (blog de la web pública, arp-web-preview) ────────────────────
    // Público lee solo publicados; los 3 editores leen y escriben todo (drafts incluidos)
    match /posts/{docId} {
      allow read:  if (resource != null && resource.data.publicado == true) || isBlogEditor();
      allow write: if isBlogEditor();
    }

    // ── cambiosPropuestos ──────────────────────────────────────────────────
    // Cualquier usuario puede proponer un cambio (create)
    // Solo admin/director/proyecto leen el listado y gestionan (update/delete)
    match /cambiosPropuestos/{docId} {
      allow read:   if isAuth() && isAdminLike();
      allow create: if isAuth();
      allow update: if isAuth() && isAdminLike();
      allow delete: if isAuth() && isAdmin();
    }

  }
}
